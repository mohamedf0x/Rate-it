DATABASE_URL="postgresql://user:password@localhost:5432/rate_it"

# Optional: swap the map tile provider (defaults to OpenStreetMap)
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap"

# Map tiles. Two tilesets so the map follows the theme instead of glowing white at night.
# Defaults are OpenStreetMap (light) and CARTO dark_all (dark); override to change provider.
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_TILE_URL_DARK="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
